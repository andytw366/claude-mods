#!/usr/bin/env python3
"""Run Claude Code in a pty and answer its XTVERSION query as iTerm2 3.5.

VS Code's terminal draws iTerm2 inline images but names itself xterm.js, so
Claude Code never sends them. This wrapper takes the query out of the stream
before VS Code sees it, answers it, and passes every other byte through.

CLAUDE_ITERM_DROP_KITTY=1 drops Claude Code's kitty graphics query unanswered.
Off by default: with the query dropped Claude Code sent no picture at all.

Claude Code also fills a picture's cells with placeholder characters plus
row/column diacritics: U+10EEEE (kitty's) or, beneath an iTerm2 picture,
U+2800 (a blank braille cell). iTerm2 draws them blank; VS Code draws the
diacritics as boxes. Each such cell becomes a space, so the cell count stays.
"""
import codecs, os, pty, re, select, signal, sys, termios, tty, fcntl, unicodedata

NAME = os.environ.get("CLAUDE_ITERM_NAME", "iTerm2 3.5.0")
QUERY = re.compile(rb"\x1b\[>0?q")
KITTY_QUERY = re.compile(rb"\x1b_G[^\x1b]*a=q[^\x1b]*\x1b\\")
ANSWER = b"\x1bP>|" + NAME.encode() + b"\x1b\\"
LOG = os.environ.get("CLAUDE_ITERM_LOG")
DROP_KITTY = os.environ.get("CLAUDE_ITERM_DROP_KITTY") == "1"


def log(msg: str) -> None:
    if LOG:
        with open(LOG, "a") as f:
            f.write(msg + "\n")


PLACEHOLDER = "\U0010EEEE"
BRAILLE_BLANK = "\u2800"


def is_mark(c: str) -> bool:
    return unicodedata.category(c) in ("Mn", "Me")


def blank_placeholders(text: str) -> str:
    """Each placeholder and the combining marks after it become one space.

    A blank braille cell counts only with marks after it, so plain braille passes through.
    """
    if PLACEHOLDER not in text and BRAILLE_BLANK not in text:
        return text
    out, i = [], 0
    while i < len(text):
        c = text[i]
        if c == PLACEHOLDER or (c == BRAILLE_BLANK and i + 1 < len(text) and is_mark(text[i + 1])):
            i += 1
            while i < len(text) and is_mark(text[i]):
                i += 1
            out.append(" ")
        else:
            out.append(text[i])
            i += 1
    return "".join(out)


def split_tail(text: str) -> tuple[str, str]:
    """Hold back a placeholder run at the end, whose marks may come in the next read."""
    j = len(text)
    while j > 0 and unicodedata.category(text[j - 1]) in ("Mn", "Me"):
        j -= 1
    if j > 0 and text[j - 1] in (PLACEHOLDER, BRAILLE_BLANK):
        return text[: j - 1], text[j - 1 :]
    return text, ""


# Queries and replies: CSI with ? > = or a final c/n/t/q, and the heads of OSC, DCS and APC.
TRACE = re.compile(rb"\x1b\[[?>=]?[0-9;]*[cntq$u]|\x1b\[[?>=][0-9;]*[a-zA-Z]|\x1b[\]P_][^\x07\x1b]{0,40}")


def trace(direction: str, data: bytes) -> None:
    if LOG:
        for m in TRACE.finditer(data):
            log(f"{direction} {m.group()!r}")


def copy_size(fd: int) -> None:
    try:
        size = fcntl.ioctl(sys.stdin.fileno(), termios.TIOCGWINSZ, b"\0" * 8)
        fcntl.ioctl(fd, termios.TIOCSWINSZ, size)
    except OSError:
        pass


def main() -> int:
    argv = sys.argv[1:] or ["claude"]
    pid, fd = pty.fork()
    if pid == 0:
        os.execvp(argv[0], argv)
    copy_size(fd)
    signal.signal(signal.SIGWINCH, lambda *_: (copy_size(fd), os.kill(pid, signal.SIGWINCH)))
    old = termios.tcgetattr(sys.stdin.fileno())
    tty.setraw(sys.stdin.fileno())
    tail = b""
    decoder = codecs.getincrementaldecoder("utf-8")(errors="surrogateescape")
    held = ""
    try:
        while True:
            try:
                r, _, _ = select.select([fd, sys.stdin.fileno()], [], [])
            except InterruptedError:
                continue
            if fd in r:
                try:
                    data = os.read(fd, 65536)
                except OSError:
                    break
                if not data:
                    break
                data = tail + data
                tail = b""
                # Hold back a partial query at the end so a split read still matches.
                for i in range(1, 5):
                    if b"\x1b[>0q"[:i] == data[-i:] or b"\x1b[>q"[:i] == data[-i:]:
                        tail, data = data[-i:], data[:-i]
                        break
                if QUERY.search(data):
                    log(f"answered XTVERSION as {NAME}")
                    data = QUERY.sub(b"", data)
                    os.write(fd, ANSWER)
                trace("app>", data)
                if DROP_KITTY and KITTY_QUERY.search(data):
                    log("dropped a kitty graphics query")
                    data = KITTY_QUERY.sub(b"", data)
                if b"]1337;" in data:
                    log("passed an iTerm2 image through")
                text, held = split_tail(held + decoder.decode(data))
                out = blank_placeholders(text)
                if LOG and (PLACEHOLDER in text or any(ord(c) >= 0xF0000 for c in out)):
                    odd = sorted({f"U+{ord(c):X}" for c in out if ord(c) >= 0xF0000})
                    log(f"placeholders in {text.count(PLACEHOLDER)}, private-use left {odd}")
                os.write(sys.stdout.fileno(), out.encode("utf-8", "surrogateescape"))
            if sys.stdin.fileno() in r:
                data = os.read(sys.stdin.fileno(), 65536)
                if not data:
                    break
                trace("term<", data)
                os.write(fd, data)
    finally:
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSAFLUSH, old)
    _, status = os.waitpid(pid, 0)
    return os.waitstatus_to_exitcode(status)


if __name__ == "__main__":
    sys.exit(main())
